{
  "name": "bee-frelon-triangulation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA collaborative pour localiser les nids de frelons asiatiques par triangulation",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
